{
    "custom/media": {
        "format": "{icon} {text}",
        "format-icons": {
            "spotify": "",
            "mpv": "",
            "vlc": "󰕼",
            "firefox": "",
            "chromium": "",
            "youtube-music": "",
            "default": ""
        },
        "return-type": "json",
        "exec": "python3 ~/.config/waybar/scripts/media-scroll.py",
        "on-click": "~/.config/waybar/scripts/media-toggle.sh",
        "on-click-right": "playerctl play-pause",
        "on-click-middle": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next",
        "tooltip": false,
        "escape": true
    }
}