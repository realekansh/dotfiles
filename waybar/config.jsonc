{
    /* =========================================================
     * GLOBAL
     * ========================================================= */
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    /* =========================================================
     * INCLUDES
     * ========================================================= */
    "include": [
        "~/.config/waybar/modules/*.jsonc",
        "~/.config/waybar/modules/custom/*.jsonc",
        "~/.config/waybar/modules/extra/*.jsonc",
        "~/.config/waybar/modules/hyprland/*.jsonc"
    ],
    /* =========================================================
     * BAR LAYOUT
     * ========================================================= */
    "modules-left": [
        "custom/app",
        "clock",
        "custom/media"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/system_popup",
        "group/connectivity",
        "group/system",
        "group/notifications"
    ],
    /* =========================================================
     * ACTIVE GROUPS
     * ========================================================= */
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth",
            "custom/vpn"
        ]
    },
    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "backlight",
            "pulseaudio",
            "pulseaudio#microphone",
            "battery"
        ]
    },
    "group/notifications": {
        "orientation": "horizontal",
        "modules": [
            "custom/hyprcaffeine",
            "custom/swaync",
            "custom/power_button"
        ]
    },
    /* =========================================================
     * OPTIONAL GROUPS
     * These remain available without appearing on the bar.
     * ========================================================= */
    "group/audio": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio#microphone"
        ]
    },
    "group/exit": {
        "orientation": "horizontal",
        "modules": [
            "custom/power_button"
        ]
    },
    "custom/hyprcaffeine": {
        "exec": "hyprcaffeine waybar",
        "on-click": "hyprcaffeine menu",
        "on-click-right": "hyprcaffeine toggle",
        "interval": 2,
        "return-type": "json"
    }
}
